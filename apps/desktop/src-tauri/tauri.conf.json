{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CashGear Sheet",
  "version": "1.6.0",
  "identifier": "com.cashgear.sheet",
  "build": {
    "beforeDevCommand": "pnpm --dir ../.. dev:web",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "CashGear Sheet",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; worker-src 'self' blob:; connect-src 'self' blob: ipc: http://ipc.localhost cgs-file: http://cgs-file.localhost",
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp",
        "Cross-Origin-Resource-Policy": "same-origin"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "CashGear",
    "copyright": "© 2026 CashGear",
    "category": "Productivity",
    "shortDescription": "CashGear Sheet",
    "longDescription": "A spreadsheet for the browser and the desktop.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU3NkVFQzk3NDczOThEODYKUldTR2pUbEhsK3h1NTN4ZEFzL3FuZzBvWDVCT1Q3eU53SDk5V1pBRWVyeGttQ1dlR3JFNXp0VkgK",
      "endpoints": [
        "https://github.com/MohamedSadat/cashgear-sheet/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
